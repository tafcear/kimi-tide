{
  "name": "dsh-kimi-bridge",
  "version": "0.1.2",
  "description": "Kimi bridge for DeepSeek Harness: call_kimi / kimi_status / kimi_abort / kimi_steer tools plus a WebUI Kimi tab observing the kimi sessions of the current session.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "dsh web --patch ./cordis.patch.yml",
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && node scripts/validate.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "dsh",
    "plugin",
    "cordis",
    "tool",
    "kimi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandashere/dsh-kimi-bridge.git"
  },
  "homepage": "https://github.com/pandashere/dsh-kimi-bridge#readme",
  "bugs": {
    "url": "https://github.com/pandashere/dsh-kimi-bridge/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "yaml": "^2.6.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "schemastery": "^3.18.0",
    "zod": "^3.23.8"
  }
}

